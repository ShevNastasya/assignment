{
  "name": "task-manager-qa-assessment",
  "private": true,
  "version": "1.0.0",
  "description": "QA Automation take-home assessment: Task Manager app + Playwright framework",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "reset-db": "node scripts/reset-db.js",
    "api": "npm run reset-db && json-server --watch api/db.json --port 3001",
    "dev": "npm run dev --workspace app",
    "build": "npm run build --workspace app",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "json-server": "^0.17.4",
    "typescript": "^5.5.4"
  }
}
